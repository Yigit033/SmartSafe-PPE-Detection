# SmartSafe Backend (Encore) - Local Development (Stable)
FROM node:20-bookworm-slim

# Gerekli araçları kuralım
RUN apt-get update && apt-get install -y curl bash binutils && rm -rf /var/lib/apt/lists/*

# Encore'u kuralım
RUN curl -L https://encore.dev/install.sh | bash

# PATH'e ekleyelim
ENV PATH="/root/.encore/bin:$PATH"

WORKDIR /app

# Bağımlılıkları kuralım
COPY backend/package*.json ./
RUN npm install

# Encore CLI ile encore.dev npm paket sürümü eşleşmeli; aksi halde `encore run` başlarken sorun çıkar.
# Image build'de bir kez; container her açılışta docker-entrypoint-backend.sh tekrar `encore version update` çalıştırır.
RUN encore version update && encore version

EXPOSE 4000
EXPOSE 9400

COPY infra/docker-entrypoint-backend.sh /docker-entrypoint-backend.sh
RUN chmod +x /docker-entrypoint-backend.sh

# PowerShell/Docker Desktop bazı ortamlarda PATH'i boş geçebiliyor; bu yüzden mutlak path kullan.
ENTRYPOINT ["/docker-entrypoint-backend.sh"]
