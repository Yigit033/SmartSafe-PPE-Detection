# SmartSafe Backend (Encore) - Local Development (Stable)
FROM node:20-bookworm-slim

# Gerekli araçları kuralım
RUN apt-get update && apt-get install -y curl bash binutils && rm -rf /var/lib/apt/lists/*

# Encore'u kuralım
RUN curl -L https://encore.dev/install.sh | bash

# PATH'e ekleyelim
ENV PATH="/root/.encore/bin:$PATH"

WORKDIR /app

# Bağımlılıkları kuralım
COPY backend/package*.json ./
RUN npm install

# Encore CLI ile encore.dev npm paket sürümü eşleşmeli; aksi halde `encore run` başlarken
# sürekli "version update" döngüsüne girip 4000'de dinleme oluşmaz (Failed to fetch).
# Build aşamasında CLI'ı güncelle ve doğrula; runtime'da tekrar update çalıştırma (döngü riski).
RUN encore version update && encore version

EXPOSE 4000
EXPOSE 9400

# PowerShell/Docker Desktop bazı ortamlarda PATH'i boş geçebiliyor; bu durumda
# `bash -lc "encore ..."` crash-loop yapar ("encore: not found"). Bu yüzden mutlak path kullan.
CMD ["/root/.encore/bin/encore", "run", "--listen", "0.0.0.0:4000"]
