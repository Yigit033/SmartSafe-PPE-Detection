# SmartSafe Frontend - Local Development
FROM node:20-alpine

# Alpine için bazı build tool'lara ihtiyaç olabilir
RUN apk add --no-cache libc6-compat curl

WORKDIR /app

# Sadece package dosyalarını kopyalayalım
COPY frontend/package*.json ./

# Sadece npm install yaparak bağımlılıkları kuralım (local node_modules ile çakışmaz)
RUN npm install

# Next.js dev server portu
EXPOSE 3377

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development

COPY infra/docker-entrypoint-frontend.sh /docker-entrypoint-frontend.sh
RUN chmod +x /docker-entrypoint-frontend.sh && sed -i 's/\r$//' /docker-entrypoint-frontend.sh

ENTRYPOINT ["/docker-entrypoint-frontend.sh"]
