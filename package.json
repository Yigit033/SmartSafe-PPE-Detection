{
  "name": "smart-safe-ai",
  "version": "0.4.12",
  "description": "SmartSafe AI - PPE Detection System",
  "main": "core/app.py",
  "scripts": {
    "core": "cd core && venv\\Scripts\\python app.py",
    "start": "npm run core",
    "install": "cd core && if not exist venv (python -m venv venv) && venv\\Scripts\\pip install -r requirements.txt",
    "dev": "docker-compose -f infra/docker-compose.yml up",
    "dev:build": "docker-compose -f infra/docker-compose.yml up --build",
    "dev:down": "docker-compose -f infra/docker-compose.yml down",
    "dev:logs": "docker-compose -f infra/docker-compose.yml logs -f",
    "docker:stop": "npm run dev:down",
    "landing": "cd landing && npm run dev",
    "prod": "node infra/scripts/version-manager.mjs && cd infra && powershell ./publish.ps1",
    "exe": "cd infra && powershell ./build_installer.ps1",
    "backend": "cd backend && node ./scripts/encore-sync-if-needed.cjs && encore run",
    "backend:sync": "cd backend && node ./scripts/encore-sync-if-needed.cjs",
    "generate": "docker exec smartsafe-backend-encore encore gen client --output=client.gen.ts && move backend\\client.gen.ts frontend\\lib\\client.ts",
    "migrate": "docker exec smartsafe-backend-encore npm run migrate"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "author": "Yigit033",
  "license": "MIT"
}