storage/violations/*

# Python bytecode (never commit)
__pycache__/
*.py[cod]

# --- Local datasets & training artifacts (keep repo clean) ---
datasets/raw/
# Keep staging datasets out of git, but allow DVC metadata files (*.dvc).
datasets/staging/*
!datasets/staging/*.dvc
training/runs/

# --- Large model artifacts (store locally, not in git) ---
models/candidates/*.pt
models/**/weights/*.pt