# SmartSafe core — kopyalayıp .env yapın; gerçek sırları buraya yazmayın / commit etmeyin.

# Yerel Docker (infra/docker-compose.infra-only.yml):
# DATABASE_URL=postgresql://smartsafe:smartsafe2024@127.0.0.1:5432/smartsafe_saas?sslmode=disable
# REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=
SECRET_KEY=

# Flask-Limiter: üretim / Docker’da Redis önerilir (memory:// eşzamanlı isteklerde threading hatası verebilir).
# Boş bırakılırsa REDIS_URL (redis:// veya rediss://) denenir; o da yoksa memory://.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# ── Üretimde tipik olarak yorumsuz tutmanız iyi olanlar (kod varsayılanlarıyla aynı) ──
# PostgreSQL: tek process içinde paylaşımlı havuz boyutu
DB_POOL_MINCONN=5
DB_POOL_MAXCONN=100

# DVR/RTSP: libav stderr gürültüsünü keser. Sorun ararken geçici olarak 16 kullanın (sadece hatalar).
OPENCV_FFMPEG_LOGLEVEL=-8
OPENCV_LOG_LEVEL=ERROR

# İsteğe bağlı — varsayılanı kodda zaten TCP + probe; değiştirmek isterseniz:
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|analyzeduration;2000000|probesize;1000000

# İsteğe bağlı DVR tarama ayarları:
# DVR_PROBE_CONCURRENCY=4
# DVR_PROBE_TTL_SUCCESS_S=600

# BBox güvenilirlik metrikleri (log): 0=kapalı, 60=her 60sn özet
# DETECTION_BBOX_SUMMARY_SEC=60
# Trackless/jitter eşikleri (opsiyonel)
# BBOX_GATE_TRACKLESS_RATIO=0.20
# BBOX_GATE_JITTER_PX=12
#
# Debug overlay: raw (kırmızı) vs final (yeşil) person bbox + ROI score
# BBOX_DEBUG=1

# DVR OSD (tarih-saat) üzerindeki sahte "person" kutuları — pose + overlay listesinde uygulanır
# OSD_PERSON_FILTER=1
# İnce ayar: OSD_PERSON_MAX_CONF=0.62  OSD_BOTTOM_Y0=0.75  OSD_SMALL_PERSON_AREA=0.008  OSD_BOTTOM_HARD_DROP_AREA=0.006
#
# Asıl kök: YOLO-Pose düşük conf ile "person" önerir — önce conf yükseltin, sonra kalite kapısı:
# POSE_PERSON_CONFIDENCE=0.62
# PERSON_QUALITY_GATE=1
# POSE_MIN_VISIBLE_KEYPOINTS=10  POSE_MIN_KP_MEAN_CONF=0.48  POSE_MIN_PERSON_AREA_RATIO=0.0009

# Decision engine: güven düşükse ihlal event üretimini bastırır (ACCEPT/UNCERTAIN/REJECT)
# DETECTION_DECISION_ENGINE=1
# ROI_REJECT_T=0.20
# ROI_UNCERTAIN_T=0.50
# FINAL_CONF_REJECT_T=0.20
# FINAL_CONF_UNCERTAIN_T=0.35
# TRACK_CONF_WARMUP_FLOOR=0.35

# Upstream gizliliği: 1=varsayılan (kimlik maskeli URL/host logda), 0=proxy-stream/mjpeg/snapshot/test loglarında host/path yok;
#   stream-status JSON’da rtsp_url null + rtsp_configured=true; kamera satırı loglarında ip/rtsp/path <redacted>
# STREAM_LOG_URL_DETAIL=0

# TELEGRAM BİLDİRİM AYARLARI
# Tüm müşteriler için ortak kullanılacak ana bot token (Multi-tenant)
DEFAULT_TELEGRAM_BOT_TOKEN=
