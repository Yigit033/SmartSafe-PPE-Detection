# SmartSafe AI - Environment-Specific Secrets (Template)
# Sadece aşağıdaki değerleri doldurmanız yeterlidir.
# Sabit yapılandırmalar core/configs/constants.py dosyasındadır.

ENV=local

# Database & Redis
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate-a-secure-key-here
JWT_SECRET_KEY=generate-a-secure-jwt-key-here
FOUNDER_PASSWORD=admin-password

# Email Credentials
SENDGRID_API_KEY=your-api-key
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Roboflow Secrets
ROBOFLOW_API_KEY=your-roboflow-key
ROBOFLOW_PUBLISHABLE_KEY=your-publishable-key

# Telegram Bot Secrets
DEFAULT_TELEGRAM_BOT_TOKEN=your-bot-token
