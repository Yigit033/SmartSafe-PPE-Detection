# SmartSafe core — kopyalayıp .env yapın; gerçek sırları buraya yazmayın / commit etmeyin.

DATABASE_URL=
SECRET_KEY=

# Flask-Limiter: üretim / Docker’da Redis önerilir (memory:// eşzamanlı isteklerde threading hatası verebilir).
# Boş bırakılırsa REDIS_URL (redis:// veya rediss://) denenir; o da yoksa memory://.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# ── Üretimde tipik olarak yorumsuz tutmanız iyi olanlar (kod varsayılanlarıyla aynı) ──
# PostgreSQL: tek process içinde paylaşımlı havuz boyutu
DB_POOL_MINCONN=5
DB_POOL_MAXCONN=100

# DVR/RTSP: libav stderr gürültüsünü keser. Sorun ararken geçici olarak 16 kullanın (sadece hatalar).
OPENCV_FFMPEG_LOGLEVEL=-8
OPENCV_LOG_LEVEL=ERROR

# İsteğe bağlı — varsayılanı kodda zaten TCP + probe; değiştirmek isterseniz:
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|analyzeduration;2000000|probesize;1000000

# İsteğe bağlı DVR tarama ayarları:
# DVR_PROBE_CONCURRENCY=4
# DVR_PROBE_TTL_SUCCESS_S=600
